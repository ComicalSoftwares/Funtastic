<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.comicalsoftwares.funtastic</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT-license</project_license>

  <name>Funtastic</name>
  <summary>A clean and simple Adwaita-style fun facts application.</summary>
  <description>
    <p>
      Funtastic is a GTK 4 and Libadwaita desktop application for GNOME that brings you interesting and fantastic fun facts every single day.
    </p>
    <p>
      You can have it start automatically on login so you can get new facts once you start your computer to help have a healthy and literal start for the day.
    </p>
  </description>

  <developer id="io.github.comicalsoftwares">
    <name>Anir El Haddaj</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://github.com/ComicalSoftwares/funtastic</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://github.com/ComicalSoftwares/funtastic</url>
  <!-- Should point to the software's bug tracking system, for users to report new bugs -->art
  <url type="bugtracker">https://github.com/ComicalSoftwares/funtastic/issues</url>

  <!-- Disabled the next lines because for the moment I do not have the corresponding resources for them -->

  <!-- Should link a FAQ page for this software, to answer some of the most-asked questions in detail -->
  <!-- URLs of this type should point to a webpage where users can submit or modify translations of the upstream project -->
  <!--<url type="translate">https://example.org/translate</url>-->
  <!--<url type="faq">https://example.org/faq</url>-->
  <!-- Should provide a web link to an online user's reference, a software manual or help page -->
  <!--<url type="help">https://example.org/help</url>-->
  <!-- URLs of this type should point to a webpage showing information on how to donate to the described software project -->
  <!--<url type="donation">https://example.org/donate</url>-->
  <!-- This could for example be an HTTPS URL to an online form or a page describing how to contact the developer -->
  <!--<url type="contact">https://example.org/contact</url>-->
  <!-- URLs of this type should point to a webpage showing information on how to contribute to the described software project -->
  <!--<url type="contribute">https://example.org/contribute</url>-->

  <translation type="gettext">funtastic</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">io.github.comicalsoftwares.funtastic.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1">
    <content_attribute id="language-humor">mild</content_attribute>
  </content_rating>


  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#02b8ab</color>
    <color type="primary" scheme_preference="dark">#00524c</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://github.com/user-attachments/assets/2d35e77a-e4a9-4cde-87fe-4ae3520dac10</image>
      <caption>Light version of the main screen</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/user-attachments/assets/d5e76ccc-c5d4-46b2-b3e4-6e9efd10d7eb</image>
      <caption>Dark version of the main screen</caption>
    </screenshot>

    <screenshot>
      <image>https://github.com/user-attachments/assets/d26595ff-2ac1-405f-a022-51bf66d66831</image>
      <caption>Light version of preferences menu</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/user-attachments/assets/2a5ac6f5-ed03-482d-9f06-bdd58788f5a5</image>
      <caption>Dark version of preferences menu</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0.0" date="2026-10-22">
      <description translate="no">
        <p>First ever release of Funtastic !</p>
        <ul>
          <li>- Ability to show fun facts every day from Wikipedia.</li>
          <li>- Ability to download and cache future facts that will be used through the week.</li>
          <li>- Ability to start the app on user login.</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
